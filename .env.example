# Конфигурация окружения Учеба24
# Скопируйте этот файл в .env и настройте под себя

# База данных
DB_HOST=localhost
DB_NAME=studapp
DB_USER=root
DB_PASS=

# Сессии (опционально)
SESSION_NAME=studapp_session
SESSION_LIFETIME=7200

# Отладка
APP_DEBUG=false
APP_ENV=production

# Логи
LOG_LEVEL=error
