# URL Rewriting для удобных ссылок
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /studapp.local/
    
    # Предотвращение прямого доступа к конфигурационным файлам
    RewriteRule ^config/ - [F,L]
    RewriteRule ^protected/ - [F,L]
    
    # Обработка 404 ошибок
    ErrorDocument 404 /studapp.local/index.php
    
    # Сжатие gzip
    <IfModule mod_deflate.c>
        AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json
    </IfModule>
    
    # Кэширование статических файлов
    <IfModule mod_expires.c>
        ExpiresActive On
        ExpiresByType image/jpg "access plus 1 year"
        ExpiresByType image/jpeg "access plus 1 year"
        ExpiresByType image/gif "access plus 1 year"
        ExpiresByType image/png "access plus 1 year"
        ExpiresByType text/css "access plus 1 month"
        ExpiresByType application/javascript "access plus 1 month"
        ExpiresByType application/pdf "access plus 1 month"
        ExpiresByType font/woff2 "access plus 1 month"
    </IfModule>
</IfModule>

# Защита от листинга каталогов
Options -Indexes

# Установка кодировки по умолчанию
AddDefaultCharset UTF-8

# Установка типа контента для PHP
AddType application/x-httpd-php .php

# Безопасность заголовков
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-XSS-Protection "1; mode=block"
</IfModule>
